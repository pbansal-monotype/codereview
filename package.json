{
  "name": "ai-pr-reviewer",
  "version": "1.0.0",
  "description": "GitHub Action for AI-powered PR reviews with configurable company guidelines",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "lint": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/__tests__"
  },
  "keywords": [
    "github-action",
    "pr-review",
    "ai",
    "code-review",
    "openai",
    "claude",
    "anthropic"
  ],
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^6.0.0",
    "@anthropic-ai/sdk": "^0.39.0",
    "openai": "^4.77.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vercel/ncc": "^0.38.3",
    "typescript": "^5.7.0"
  }
}
