{
  "name": "ai-pr-reviewer",
  "version": "1.0.0",
  "description": "GitHub Action for AI-powered PR reviews with configurable company guidelines",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "lint": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/__tests__",
    "test-agent": "npx ts-node src/eval/run-agent-local.ts",
    "local-review": "npx ts-node src/cli/local-review.ts",
    "history-db:up": "docker compose up -d",
    "history-db:down": "docker compose down",
    "history-db:logs": "docker compose logs -f rest db"
  },
  "keywords": [
    "github-action",
    "pr-review",
    "ai",
    "code-review",
    "openai",
    "claude",
    "anthropic"
  ],
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^6.0.0",
    "@anthropic-ai/sdk": "^0.39.0",
    "openai": "^4.77.0",
    "tree-sitter": "^0.25.0",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-python": "^0.25.0",
    "ts-morph": "^28.0.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vercel/ncc": "^0.38.3",
    "typescript": "^5.7.0"
  }
}
