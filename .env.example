# ─── GitHub (required for local-review) ─────────────────────────────
# PAT with pull-requests:read + contents:read on the target repo.
GITHUB_TOKEN=

# ─── LLM provider ───────────────────────────────────────────────────
# anthropic | openai | azure
REVIEW_PROVIDER=azure
AZURE_API_KEY=
AZURE_ENDPOINT=
# REVIEW_MODEL=   # optional override; azure defaults to gpt-5.4-nano

# ─── Local history DB (docker compose) ──────────────────────────────
# PostgREST on localhost:54321 — start with: docker compose up -d
SUPABASE_URL=http://127.0.0.1:54321
# Local-only JWT signed with the compose JWT secret (role=service_role).
# Safe for localhost; never use this key against a real Supabase project.
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoibG9jYWwtcHItcmV2aWV3ZXIiLCJleHAiOjIxMDI0OTEyNTl9.8_v9uY7d77MZLoZuRqwNivx-f0kYQGqO220kgyQgLXU
